# Copy this file to .env.local and fill in the values (see README.md → "Connect Sanity").

# Sanity project (from https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token with "Editor" rights — lets the enquiry form and newsletter save entries into Sanity.
SANITY_API_WRITE_TOKEN=

# Optional: secret for the /api/revalidate webhook (instant updates after publishing in Sanity)
SANITY_REVALIDATE_SECRET=

# Optional: email each enquiry via Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_FROM=Élané Villas <reservations@yourdomain.com>
ENQUIRY_TO=reservations@elanevillas.com

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
